# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/

# ── Build output ───────────────────────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Environment variables — NEVER commit real .env ────────────────────────────
.env
.env.local
.env.*.local

# ── Uploaded files (local dev only — use S3 in prod) ──────────────────────────
server/uploads/*
!server/uploads/.gitkeep

# ── OS & editor junk ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo *.ntvs* *.njsproj *.sln *.sw?

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/ *.log npm-debug.log* yarn-debug.log* pnpm-debug.log*

# ── Misc ───────────────────────────────────────────────────────────────────────
.cache/ .temp/
