# Copy this file to .env and fill in your values — DO NOT commit .env

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/agriconnect?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-char-random-string

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS (set to your Vercel URL in production) ─────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Frontend (set in Vercel dashboard, NOT here) ────────────────────────────
VITE_API_URL=http://localhost:4000/api

# ─── AWS S3 (optional — local disk fallback if not set) ──────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
